MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=asaka_japan
APP_HOST=0.0.0.0
APP_PORT=8017
# On Render, PORT is injected automatically — APP_PORT is only a local fallback.
AUTHOR=ASAKA
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cloudinary (required on Render so uploads persist)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (PWA) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:crm@asaka.jp

# Groq — chatbot CRM (free tier, OpenAI-compatible)
# Lấy key: https://console.groq.com/keys
GROQ_API_KEY=
# Primary: thông minh nhất (1K RPD). Hết hạn mức ngày → fallback.
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback nhanh + hạn mức cao (14.4K RPD). Có thể thêm: openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=llama-3.1-8b-instant

# Google Maps Geocoding — địa chỉ đại lý/kho → GPS khi tạo chuyến
# (bật Geocoding API trên Google Cloud; có thể dùng chung key với FE Maps)
GOOGLE_MAPS_API_KEY=

# Email hóa đơn — local: Gmail SMTP. Render free chặn 587/465 → dùng Gmail API (HTTPS).
# 1) Google Cloud → APIs → enable Gmail API
# 2) Credentials → OAuth client type Desktop
# 3) Từ BE/: npm run gmail-oauth  (dán Client ID/Secret, copy refresh token)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=asakajapan.company@gmail.com
SMTP_PASS=
MAIL_FROM=asakajapan.company@gmail.com
MAIL_FROM_NAME=Asaka Japan
# Link đăng nhập trong mail cấp TK / phiếu lương (optional)
CRM_APP_URL=https://crm-asaka-japan.vercel.app
