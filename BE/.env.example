MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=asaka_japan
APP_HOST=0.0.0.0
APP_PORT=8017
# On Render, PORT is injected automatically — APP_PORT is only a local fallback.
AUTHOR=ASAKA
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cloudinary (required on Render so uploads persist)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram Bot (create via @BotFather, then set TELEGRAM_ENABLED=true)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Leave empty for local long-polling. Set HTTPS URL in production, e.g.
# https://api.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram chat_id of sales/warehouse staff for internal alerts
TELEGRAM_STAFF_CHAT_IDS=

# Web Push (PWA) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@asaka.local
