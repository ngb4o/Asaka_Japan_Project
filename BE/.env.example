MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=asaka_japan
APP_HOST=0.0.0.0
APP_PORT=8017
# On Render, PORT is injected automatically — APP_PORT is only a local fallback.
AUTHOR=ASAKA
JWT_SECRET=change_me_to_a_long_random_string
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cloudinary (required on Render so uploads persist)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (PWA) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:crm@asaka.jp

# Groq — chatbot CRM (free tier, OpenAI-compatible)
# Lấy key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Optional extras (sau model chính): llama-3.3-70b-versatile,openai/gpt-oss-20b
GROQ_MODEL_FALLBACKS=
