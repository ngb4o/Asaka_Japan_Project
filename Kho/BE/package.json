{
  "name": "kho-api",
  "private": true,
  "version": "1.0.0",
  "description": "API quản lý sản phẩm trong kho",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "cross-env BUILD_MODE=dev nodemon --exec babel-node ./src/server.js",
    "start": "cross-env BUILD_MODE=production node ./build/src/server.js",
    "build": "rm -rf build && babel ./src -d ./build/src"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "async-exit-hook": "^2.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "joi": "^17.10.2",
    "mongodb": "5.5",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.47.0",
    "nodemon": "^3.0.1"
  }
}
